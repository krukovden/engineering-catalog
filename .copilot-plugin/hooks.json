{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "ROOT=\"${COPILOT_PLUGIN_ROOT:-$PWD}\"; cd \"${COPILOT_PROJECT_DIR:-$PWD}\" && sh \"$ROOT/hooks/scripts/catalog-freshness-hook.sh\" --quiet --json",
        "powershell": "$root = if ($env:COPILOT_PLUGIN_ROOT) { $env:COPILOT_PLUGIN_ROOT } else { $PWD.Path }; if ($env:COPILOT_PROJECT_DIR) { Set-Location $env:COPILOT_PROJECT_DIR }; & \"$root/hooks/scripts/catalog-freshness-hook.ps1\" -Quiet -Json",
        "timeoutSec": 30
      }
    ]
  }
}
